// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Events { 
  id String @id @default(uuid()) 
  name String 
  descirption String
  eventDate DateTime
  venue String?
  createdAt  DateTime @default(now())
  updatedAt DateTime
  certificates Certifate[]


}

model Certifate { 
  certId String @id @default(uuid()) 
  eventId String 
  holderName String
  rollNumber BigInt
  branch String
  issuedAt DateTime 
  createdAt DateTime @default(now())

  event Events @relation(fields: [certId], references: [id])
}