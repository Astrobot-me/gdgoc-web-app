// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id           Int            @id @default(autoincrement())
  name         String
  description  String?
  eventDate    DateTime
  venue        String?
  bannerUrl    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  certificates Certificate[]
  verifyLogs   VerificationLog[]
}

model Certificate {
  id    Int            @id @default(autoincrement())
  credentialId String @default(nanoid()) @unique
  certificateId   String            @unique
  eventId         Int
  holderName      String
  rollNumber      String
  branch          String
  description     String?
  certificateType CertificateType   @default(PARTICIPATION)
  issuedAt        DateTime          @default(now())
  revokedAt       DateTime?
  createdAt       DateTime          @default(now())
  event           Event             @relation(fields: [eventId], references: [id])
  verifyLogs      VerificationLog[]

  @@index([eventId])
  @@index([certificateType])
  @@index([credentialId])
  @@index([rollNumber])
}

model VerificationLog {
  id          String             @id @default(nanoid())
  certId      String?
  eventId     Int?
  status      VerificationStatus
  userAgent   String?
  referer     String?
  createdAt   DateTime           @default(now())
  certificate Certificate?       @relation(fields: [certId], references: [credentialId])
  event       Event?             @relation(fields: [eventId], references: [id])

  @@index([certId])
  @@index([eventId])
  @@index([createdAt])
}

enum VerificationStatus {
  VALID
  REVOKED
  NOT_FOUND
}

enum CertificateType {
  PARTICIPATION
  WINNER
}
